# Copy to .env and fill in what you need. Every one of these is optional: with
# none of them set, the site runs and the intake form works — it reads a brand's
# catalogue and produces a brief, and tells the brand a human will take it from
# there. The variables below only change where that brief goes next.

# The brand factory's HTTP API, if one is running. When set, a submitted brief
# is POSTed to $FACTORY_URL/api/brief and the brand is told the build is queued.
# Unset, the form says a human will pick it up — which is true, and better than
# claiming a build that never started.
# FACTORY_URL=https://factory.internal.example.com

# Sent as `Authorization: Bearer ...` with that POST, if the factory wants one.
# FACTORY_TOKEN=

# Any endpoint that accepts { "text": "..." } — a Slack incoming webhook, for
# instance. Gets one line per submission so the team knows a brand came in.
# Failing to reach it never fails the submission.
# INTAKE_WEBHOOK_URL=

# How long /api/analyse may spend reading a shop's catalogue before it answers
# with a partial read. Keep it comfortably under the platform's function
# timeout: a killed function returns a blank 504, which tells the brand nothing.
# Default 45000.
# ANALYSE_BUDGET_MS=45000
